{
  "name": "themehybrid/hybrid-assets",
  "description": "Assets helper package for the Hybrid Core framework.",
  "license": "GPL-2.0-or-later",
  "type": "library",
  "keywords": [
    "wordpress"
  ],
  "authors": [
    {
      "name": "Theme Hybrid",
      "email": "themehybrid@gmail.com",
      "homepage": "https://themehybrid.com",
      "role": "Developer"
    }
  ],
  "homepage": "https://github.com/themehybrid/hybrid-assets",
  "support": {
    "issues": "https://github.com/themehybrid/hybrid-assets/issues"
  },
  "require": {
    "php": ">=8.2",
    "themehybrid/hybrid-core": "^7.0",
    "themehybrid/hybrid-tools": "^2.0"
  },
  "require-dev": {
    "brain/monkey": "^2.6",
    "mockery/mockery": "^1.6",
    "pestphp/pest": "^3.7",
    "pestphp/pest-plugin-mutate": "^3.0"
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "autoload": {
    "psr-4": {
      "Hybrid\\Assets\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Hybrid\\Assets\\Tests\\": "tests/"
    }
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true,
      "pestphp/pest-plugin-mutate": true
    },
    "sort-packages": true
  },
  "scripts": {
    "test": "pest",
    "test:mutate": "pest --mutate --parallel"
  }
}
